rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'istihadj@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Tournaments collection
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(tournamentId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(categoryId);
    }

    // Courts collection
    match /courts/{courtId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(courtId);
    }

    // Teams & Rosters collection
    match /teams/{teamId} {
      allow read: if true;
      allow create: if (isAdmin() || isVerifiedUser()) && isValidId(teamId);
      allow update: if (
        isAdmin() || 
        (isVerifiedUser() && existing().coachId == request.auth.uid)
      ) && isValidId(teamId);
      allow delete: if isAdmin() && isValidId(teamId);
    }

    // Matches & Live Scores collection
    match /matches/{matchId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(matchId);
      allow update: if (
        isAdmin() ||
        (isSignedIn() && (
          existing().refereeId == request.auth.uid || 
          existing().status != 'COMPLETED'
        ))
      ) && isValidId(matchId);
      allow delete: if isAdmin() && isValidId(matchId);
    }

    // Audit logs collection (Append only)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false;
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isVerifiedUser() && request.auth.uid == userId && isValidId(userId) && (
        !('role' in incoming()) || incoming().role != 'ADMIN'
      );
      allow update: if (
        isAdmin() || 
        (
          isVerifiedUser() && 
          request.auth.uid == userId && 
          !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isApproved'])
        )
      ) && isValidId(userId);
      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
